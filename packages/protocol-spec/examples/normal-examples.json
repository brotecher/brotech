            "id": "project-portrait",
            "typeId": "mj.core/project",
            "version": "1.0.0"
          },
          "reviewerRef": {
            "id": "reviewer-local",
            "typeId": "mj.core/reviewer",
            "version": "1.0.0"
          }
        }
      }
    },
    {
      "id": "normal-cap",
      "family": "CAP",
      "schemaId": "urn:mojing:protocol:cap:1.0.0",
      "ruleIds": ["PROTOCOL-RULE-CAP-001", "PROTOCOL-RULE-CAP-002"],
      "expected": "valid",
      "value": {
        "id": { "id": "cap-world-query", "typeId": "mj.core/capability", "version": "1.0.0" },
        "inputs": [{ "name": "query", "typeRef": "mj.core/text", "required": true }],
        "outputs": [
          { "name": "personSnapshot", "typeRef": "mj.core/person-snapshot", "required": true }
        ],
        "permission": "world.read",
        "publicErrors": ["missing-input", "missing-reference", "permission-denied"],
        "usageCost": {
          "mode": "fixed",
          "amount": 1,
          "unit": "synthetic-unit",
          "source": "deterministic-fixture"
        },
        "sideEffect": "read",
        "deterministicMockEntry": "mock://world-query/1.0.0"
      }
    },
    {
      "id": "normal-node",
      "family": "NODE",
      "schemaId": "urn:mojing:protocol:node:1.0.0",
      "ruleIds": ["PROTOCOL-RULE-NODE-001", "PROTOCOL-RULE-NODE-002"],
      "expected": "valid",
      "value": {
        "id": { "id": "node-world-query", "typeId": "mj.core/node", "version": "1.0.0" },
        "category": "query",
        "inputPorts": [{ "name": "query", "typeRef": "mj.core/text", "required": true }],
        "outputPorts": [
          { "name": "personSnapshot", "typeRef": "mj.core/person-snapshot", "required": true }
