        "reviewPoints": [{ "nodeId": "query-person", "reviewerRequired": true }],
        "changeDecisionPath": "query-person.review-to-change-decision",
        "dependencyLock": [
          { "id": "node-world-query", "typeId": "mj.core/node", "version": "1.0.0" },
          { "id": "cap-world-query", "typeId": "mj.core/capability", "version": "1.0.0" }
        ]
      }
    },
    {
      "id": "normal-run",
      "family": "RUN",
