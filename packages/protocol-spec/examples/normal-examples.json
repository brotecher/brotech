        "parameters": [{ "name": "personName", "typeRef": "mj.core/text", "required": true }],
        "capabilityDependencies": [
          { "id": "cap-world-query", "typeId": "mj.core/capability", "version": "1.0.0" }
        ],
        "permissionDependencies": ["world.read"],
        "sideEffectPolicy": "read",
        "costPolicy": "fixed",
        "errorExits": ["missing-input", "missing-reference", "permission-denied", "timeout"],
        "timeout": { "milliseconds": 5000, "outcome": "failed" },
        "retry": { "maxAttempts": 2, "retryableErrors": ["timeout"], "backoff": "fixed" },
        "cancellation": { "supported": true, "lateResultPolicy": "discard" },
        "cache": {
          "mode": "read-only",
          "keyIncludes": [
            "capabilityVersion",
            "implementationVersion",
            "inputHash",
            "permissionHash",
            "dataVersion"
          ]
        },
        "idempotency": {
          "required": true,
          "keyScope": "run-node",
          "effectIdentity": "candidate-output"
        }
      }
    },
    {
      "id": "normal-workflow",
      "family": "WORKFLOW",
      "schemaId": "urn:mojing:protocol:workflow:1.0.0",
      "ruleIds": ["PROTOCOL-RULE-WORKFLOW-001", "PROTOCOL-RULE-WORKFLOW-002"],
      "expected": "valid",
      "value": {
        "id": { "id": "workflow-portrait", "typeId": "mj.core/workflow", "version": "1.0.0" },
        "inputs": [{ "name": "personName", "typeRef": "mj.core/text", "required": true }],
        "outputs": [{ "name": "summary", "typeRef": "mj.core/summary", "required": true }],
        "nodes": [
          {
            "nodeId": "input-name",
            "nodeRef": { "id": "node-person-input", "typeId": "mj.core/node", "version": "1.0.0" }
          },
          {
            "nodeId": "query-person",
            "nodeRef": { "id": "node-world-query", "typeId": "mj.core/node", "version": "1.0.0" }
          }
        ],
        "connections": [
          {
            "fromNode": "input-name",
            "fromPort": "name",
            "toNode": "query-person",
            "toPort": "query",
            "typeRef": "mj.core/text"
          }
        ],
        "entryNodeId": "input-name",
        "failurePaths": [
          "missing-input",
          "missing-reference",
          "invalid-candidate",
          "permission-denied",
          "rejected",
          "version-conflict",
          "timeout",
          "cancelled"
